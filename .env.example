# ---------------------------------------------------------------------------
# Diretorios
# ---------------------------------------------------------------------------
DATA_DIR=./data

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text
# LOG_FORMAT=json

# ---------------------------------------------------------------------------
# LLM (extracao de referencias + juiz)
# Provider "local" usa um endpoint OpenAI-compatible (LM Studio/Ollama) sem
# necessidade de chave. "openai" e "anthropic" exigem a respectiva API key.
# ---------------------------------------------------------------------------
LLM_PROVIDER=local
LLM_BASE_URL=http://localhost:1234/v1/
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2.0

# Necessario apenas quando LLM_PROVIDER=openai
OPENAI_API_KEY=

# Necessario apenas quando LLM_PROVIDER=anthropic. Recomendacao de custo/
# qualidade para o juiz: claude-sonnet-5 (bom equilibrio); claude-haiku-4-5
# para volume alto e custo minimo; claude-opus-5 para maxima qualidade.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Embeddings / reranking / vetor store (usado a partir da Fase 2 - indexing)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MODEL_CACHE_DIR=./model_cache
RETRIEVAL_TOP_K=50
RERANK_TOP_K=20

# ---------------------------------------------------------------------------
# Verificacao de vereditos UNSUPPORTED (cascata A -> B -> C).
# Executa sempre no `audit run`, sem flag: todo chunk com veredito inicial
# UNSUPPORTED passa por (A) expansao de contexto na referencia citada,
# (B) varredura do documento citado inteiro e (C) checagem no corpus todo.
# ---------------------------------------------------------------------------
VERIFICATION_NEIGHBOR_WINDOW=1
VERIFICATION_RERANK_TOP_K=40
VERIFICATION_FULL_DOC_WINDOW_TOKENS=6000
VERIFICATION_FULL_DOC_WINDOW_OVERLAP=300
